# Revalidate page entry points so normal navigation sees the latest hashed assets.
# Long-lived caching for content-addressed JS, CSS and images is unaffected.
<IfModule mod_headers.c>
  <FilesMatch "\.html?$">
    Header always set Cache-Control "no-cache, must-revalidate"
    Header always unset Expires
  </FilesMatch>
  # Also cover directory entry points, including the homepage at /.
  Header always set Cache-Control "no-cache, must-revalidate" "expr=%{REQUEST_URI} =~ m#/$#"
</IfModule>

# Хостинг не знает .webm и отдаёт видео как text/plain, да ещё сжатым
# (gzip/br). Браузер при первом заходе не может его воспроизвести, и
# видео-обложки остаются на заглушке до перезагрузки. Правильный тип
# и отказ от сжатия возвращают обычную потоковую отдачу с Range.
AddType video/webm .webm
AddType video/mp4 .mp4
<IfModule mod_deflate.c>
  SetEnvIfNoCase Request_URI "\.(?:webm|mp4)$" no-gzip dont-vary
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(?:webm|mp4)$">
    Header set Accept-Ranges bytes
  </FilesMatch>
</IfModule>

# На сайте опубликованы только описанные кейсы (pages/home/data/projects.js).
# Страницы разделов и незаполненные заготовки временно (302) ведут на
# ленту Главной. Файлы остаются
# в репозитории; чтобы вернуть страницу, достаточно убрать её из правил.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^projects/(?:avito-charity|ozon-crm)/?(?:index\.html)?$ /#works-gallery [R=302,NE,L]
  RewriteRule ^projects/avito-charity/(?:about-company|charity-profile|donation-subscription|gamification|rebranding)(?:/.*)?$ /#works-gallery [R=302,NE,L]
  RewriteRule ^projects/ozon-crm/(?:campaign-creation|campaigns|customer-portrait|customers|seller-home)(?:/.*)?$ /#works-gallery [R=302,NE,L]
  RewriteRule ^projects/(?:ozon-prices|swtec-angel|swtec-medical|concepts|activities)(?:/.*)?$ /#works-gallery [R=302,NE,L]
</IfModule>
