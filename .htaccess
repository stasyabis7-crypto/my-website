# Revalidate page entry points so normal navigation sees the latest hashed assets.
# Long-lived caching for content-addressed JS, CSS and images is unaffected.
<IfModule mod_headers.c>
  <FilesMatch "\.html?$">
    Header always set Cache-Control "private, no-cache, must-revalidate"
    Header always unset Expires
  </FilesMatch>
  # Also cover directory entry points, including the homepage at /.
  Header always set Cache-Control "private, no-cache, must-revalidate" "expr=%{REQUEST_URI} =~ m#/$#"
  # Country comes from the hosting GeoIP database, never a client-supplied header.
  # Private HTML prevents a CDN sharing one visitor's country cookie with another.
</IfModule>

# Hostinger/LiteSpeed provides GeoIP locally, with no external lookup request.
<IfModule LiteSpeed>
  GeoIPEnable On
</IfModule>
<IfModule mod_geoip.c>
  GeoIPEnable On
</IfModule>

# Хостинг не знает .webm и отдаёт видео как text/plain, да ещё сжатым
# (gzip/br). Браузер при первом заходе не может его воспроизвести, и
# видео-обложки остаются на заглушке до перезагрузки. Правильный тип
# и отказ от сжатия возвращают обычную потоковую отдачу с Range.
AddType video/webm .webm
AddType video/mp4 .mp4
<IfModule mod_deflate.c>
  SetEnvIfNoCase Request_URI "\.(?:webm|mp4)$" no-gzip dont-vary
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(?:webm|mp4)$">
    Header set Accept-Ranges bytes
  </FilesMatch>
</IfModule>

# На сайте опубликованы только описанные кейсы (pages/home/data/projects.js).
# Страницы разделов и незаполненные заготовки временно (302) ведут на
# ленту Главной. Страниц-галерей разделов больше нет — правила для их адресов
# оставлены для старых ссылок; заготовки можно вернуть, убрав их из правил.
<IfModule mod_rewrite.c>
  RewriteEngine On
  # LiteSpeed exposes GeoIP during rewriting, before response-header processing.
  # Limit the country cookie to page requests so assets remain CDN-cacheable.
  RewriteCond %{REQUEST_URI} (?:/|\.html)$
  RewriteCond %{ENV:GEOIP_COUNTRY_CODE} ^([A-Z]{2})$
  RewriteRule ^ - [CO=portfolio-country:%1:stasyabis.com:1440:/:true:false]
  # Redirect only browser requests, never Apache's internal DirectoryIndex lookup.
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html(?:[?\s]) [NC]
  RewriteRule ^(.*/)?index\.html$ /$1 [R=301,NE,L]
  # Previous standalone .html addresses resolve to their existing directory page.
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+)\.html$ /$1/ [R=301,NE,L]
  # Обложки ленты Главной лежат в covers/ кейсов, в том числе ещё не
  # опубликованных («Скоро появится»): сами файлы отдаются, редиректятся
  # только страницы.
  RewriteRule ^projects/.+/covers/[^/]+\.(?:webp|png|jpe?g|avif|svg|mp4|webm)$ - [L]
  # Карта временно скрыта, исходники кейса сохранены для повторной публикации.
  RewriteRule ^projects/(?:avito-charity/)?recycle-map/?(?:index\.html)?$ /#works-gallery [R=302,NE,L]
  RewriteRule ^projects/(?:avito-charity|ozon-crm)/?(?:index\.html)?$ /#works-gallery [R=302,NE,L]
  RewriteRule ^projects/avito-charity/(?:about-company|charity-profile|donation-subscription|gamification|rebranding)(?:/.*)?$ /#works-gallery [R=302,NE,L]
  RewriteRule ^projects/ozon-crm/(?:campaign-creation|campaigns|customer-portrait|customers|seller-home)(?:/.*)?$ /#works-gallery [R=302,NE,L]
  RewriteRule ^projects/(?:ozon-prices|swtec-angel|swtec-medical)(?:/.*)?$ /#works-gallery [R=302,NE,L]
  # Старая страница концептов заменена на Playground; её картинки (covers/)
  # Playground берёт отсюда, поэтому редиректится только сама страница.
  RewriteRule ^projects/concepts/?(?:index\.html)?$ /projects/playground/ [R=302,L]
  # Бывшая страница «Активности» разделена на «Статьи» и «Посты».
  RewriteRule ^projects/activities/?(?:index\.html)?$ /projects/articles/ [R=301,L]
  RewriteRule ^projects/posts/?(?:index\.html)?$ / [R=301,L]
</IfModule>
